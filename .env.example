# Copy to .env (gitignored) and fill in.

# Supabase → Connect → Session pooler (port 5432). Same database as the Spring app;
# everything we create lives in the `ai` schema.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Local alternative: `docker compose up -d db`
# DATABASE_URL=postgresql://shv:shv@localhost:5433/shv_ai

# Shared secret with Spring (Spring's AI_SERVICE_TOKEN). openssl rand -hex 32
SERVICE_TOKEN=change-me

# Spring backend (local: ./mvnw spring-boot:run -Dspring-boot.run.profiles=local)
SPRING_BASE_URL=http://localhost:2424

# https://dashboard.voyageai.com → API keys. Without it, indexing is disabled (--dry-run still works).
VOYAGE_API_KEY=

# Optional
# LOG_LEVEL=INFO
# DB_POOL_MAX=3
